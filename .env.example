# OpenAI-compatible chat model.
# The sample values target Zhipu (BigModel) GLM. Any compatible endpoint works.
LLM_API_KEY=
LLM_MODEL=glm-5
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
LLM_TEMPERATURE=0.6

# Local embeddings served by Ollama.
# 本机直接运行时用下面这个地址。
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_EMBEDDING_MODEL=bge-m3:latest

# docker compose 里容器访问本机 Ollama 的地址。
# 不设则默认为 http://host.docker.internal:11434。
# 本机直接运行时不用改这个变量；.env 里的 OLLAMA_BASE_URL=127.0.0.1
# 不会被带进容器（否则容器会连到自己而不是宿主机上的 Ollama）。
# DOCKER_OLLAMA_BASE_URL=http://host.docker.internal:11434
