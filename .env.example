# OpenAI-compatible chat model.
# The sample values target Zhipu (BigModel) GLM. Any compatible endpoint works.
LLM_API_KEY=
LLM_MODEL=glm-5
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
LLM_TEMPERATURE=0.6

# Embedding provider: ollama (default, local) or api (OpenAI-compatible, e.g. SiliconFlow).
# Leave unset or set to ollama for local development; existing behavior is unchanged.
EMBEDDING_PROVIDER=ollama

# Local embeddings served by Ollama. Used when EMBEDDING_PROVIDER=ollama.
# 本机直接运行时用下面这个地址。
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_EMBEDDING_MODEL=bge-m3:latest

# docker compose 里容器访问本机 Ollama 的地址。
# 不设则默认为 http://host.docker.internal:11434。
# 本机直接运行时不用改这个变量；.env 里的 OLLAMA_BASE_URL=127.0.0.1
# 不会被带进容器（否则容器会连到自己而不是宿主机上的 Ollama）。
# 使用 EMBEDDING_PROVIDER=api 时不需要 Ollama，可以忽略这两项。
# DOCKER_OLLAMA_BASE_URL=http://host.docker.internal:11434

# OpenAI-compatible embedding API. Used when EMBEDDING_PROVIDER=api.
# 默认指向硅基流动（SiliconFlow）的免费 BAAI/bge-m3，不要填 Pro/BAAI/bge-m3。
# EMBEDDING_API_KEY=
# EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
# EMBEDDING_MODEL=BAAI/bge-m3
# SiliconFlow 单次最多 32 条文本；一般不用改。
# EMBEDDING_BATCH_SIZE=32

# /chat 按客户端 IP 的每分钟请求上限。0 表示关闭限流。
RATE_LIMIT_PER_MINUTE=10
# 直接用 IP:端口 访问时保持 false，避免客户端伪造 X-Forwarded-For 绕过限流。
# 若前面加了 Nginx 等反向代理，再改为 true。
# TRUST_FORWARDED_FOR=false

# Streamlit 把提问转到 FastAPI /chat 时使用。docker compose 的 web 服务默认是 http://api:8000。
# 本机单独跑 Streamlit、不经过 API 时不要设置。
# API_BASE_URL=http://127.0.0.1:8000
